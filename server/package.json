{
  "name": "skyvault-server",
  "version": "1.0.0",
  "description": "SkyVault Backend Server",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "backend",
    "server",
    "skyvault",
    "cloud",
    "storage",
    "aws",
    "s3"
  ],
  "author": "Ravindra Yadav",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravindrayadav26/skyvault.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/cloudfront-signer": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.11",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "systeminformation": "^5.27.11",
    "winston": "^3.18.3",
    "winston-mongodb": "^7.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  }
}
